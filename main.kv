#:import get_color_from_hex kivy.utils.get_color_from_hex

MDScreen:
    md_bg_color: 0, 0, 0, 1

    # Círculo Neon de Fundo
    Widget:
        canvas:
            Color:
                rgba: get_color_from_hex('#39FF14')
            Line:
                circle: (self.center_x, self.center_y + dp(100), dp(85))
                width: dp(2)
            Color:
                rgba: 0.22, 1, 0.08, 0.15
            Line:
                circle: (self.center_x, self.center_y + dp(100), dp(92))
                width: dp(5)

    MDBoxLayout:
        orientation: 'vertical'
        padding: dp(25)
        spacing: dp(15)

        MDLabel:
            text: "SUPREMEFLY REGEDIT"
            halign: "center"
            font_style: "H4"
            bold: True
            theme_text_color: "Custom"
            text_color: get_color_from_hex('#39FF14')

        Widget:
            size_hint_y: None
            height: dp(180) # Espaço para o círculo

        MDLabel:
            text: "SENSIBILIDADE X (VERTICAL)"
            theme_text_color: "Secondary"
            font_style: "Caption"

        MDSlider:
            id: sensi_x
            min: 0
            max: 1000
            value: 500
            color: get_color_from_hex('#39FF14')

        MDLabel:
            text: "SENSIBILIDADE Y (LATERAL)"
            theme_text_color: "Secondary"
            font_style: "Caption"

        MDSlider:
            id: sensi_y
            min: 0
            max: 1000
            value: 500
            color: get_color_from_hex('#39FF14')

        MDFillRoundFlatButton:
            text: "INJETAR NO HARDWARE"
            size_hint_x: 1
            md_bg_color: get_color_from_hex('#39FF14')
            text_color: 0, 0, 0, 1
            on_release: app.apply_hardware_logic()

        MDLabel:
            id: log_label
            text: "> SISTEMA PRONTO"
            halign: "center"
            theme_text_color: "Custom"
            text_color: get_color_from_hex('#39FF14')
