#:import get_color_from_hex kivy.utils.get_color_from_hex

MDScreen:
    md_bg_color: 0, 0, 0, 1  # Fundo preto absoluto

    # Desenho do Círculo Neon (O detalhe da foto)
    Widget:
        canvas:
            Color:
                rgba: get_color_from_hex('#39FF14') # Verde Neon
            Line:
                circle: (self.center_x, self.center_y + dp(100), dp(80))
                width: 2
            Color:
                rgba: get_color_from_hex('#39FF1433') # Brilho suave (transparente)
            Line:
                circle: (self.center_x, self.center_y + dp(100), dp(85))
                width: 4

    MDBoxLayout:
        orientation: 'vertical'
        padding: [dp(25), dp(50), dp(25), dp(25)]
        spacing: dp(15)

        MDLabel:
            text: "SUPREMEFLY V3"
            halign: "center"
            font_style: "H4"
            bold: True
            theme_text_color: "Custom"
            text_color: get_color_from_hex('#39FF14')
            size_hint_y: None
            height: dp(60)

        # Espaçador para o círculo não ficar em cima do texto
        Widget:
            size_hint_y: None
            height: dp(160)

        # --- CONTROLES ---
        MDLabel:
            text: "SENSIBILIDADE VERTICAL (X)"
            theme_text_color: "Secondary"
            font_style: "Caption"

        MDSlider:
            id: sensi_x
            min: 0
            max: 1000
            value: 500
            color: get_color_from_hex('#39FF14')
            hint: True

        MDLabel:
            text: "SENSIBILIDADE LATERAL (Y)"
            theme_text_color: "Secondary"
            font_style: "Caption"

        MDSlider:
            id: sensi_y
            min: 0
            max: 1000
            value: 500
            color: get_color_from_hex('#39FF14')
            hint: True

        # --- SWITCHES NATIVOS ---
        MDBoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(50)
            MDLabel:
                text: "PRIORIDADE DE ARRASTÃO"
                theme_text_color: "Primary"
            MDSwitch:
                id: switch_prio
                active: True
                thumb_color_active: get_color_from_hex('#39FF14')

        MDFillRoundFlatButton:
            text: "INJETAR NO HARDWARE"
            font_style: "Button"
            size_hint_x: 1
            md_bg_color: get_color_from_hex('#39FF14')
            text_color: 0, 0, 0, 1
            on_release: app.apply_hardware_logic()

        MDLabel:
            id: log_label
            text: "> Sistema Pronto"
            halign: "center"
            font_style: "Caption"
            theme_text_color: "Hint"
