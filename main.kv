#:import get_color_from_hex kivy.utils.get_color_from_hex

MDScreen:
    md_bg_color: 0, 0, 0, 1  # Fundo Preto Total (Essencial para o Neon)

    # Camada de Desenho (O Círculo da Foto)
    Widget:
        canvas:
            Color:
                rgba: get_color_from_hex('#39FF14') # Verde Neon
            Line:
                # Desenha o círculo centralizado
                circle: (self.center_x, self.center_y + dp(100), dp(80))
                width: dp(1.5)
            Color:
                rgba: 0.22, 1, 0.08, 0.1 # Sombra/Brilho do Neon
            Line:
                circle: (self.center_x, self.center_y + dp(100), dp(85))
                width: dp(4)

    MDBoxLayout:
        orientation: 'vertical'
        padding: dp(20)
        spacing: dp(10)

        MDLabel:
            text: "SUPREMEFLY REGEDIT"
            halign: "center"
            font_style: "H5"
            bold: True
            theme_text_color: "Custom"
            text_color: get_color_from_hex('#39FF14')

        # Espaço reservado para o círculo não ficar embaixo do texto
        Widget:
            size_hint_y: None
            height: dp(180)

        MDLabel:
            text: "SENSIBILIDADE DE HARDWARE"
            theme_text_color: "Secondary"
            font_style: "Caption"
            halign: "center"

        MDSlider:
            id: sensi_x
            min: 0
            max: 1000
            value: 500
            color: get_color_from_hex('#39FF14')

        MDBoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(50)
            MDLabel:
                text: "OTIMIZAR ARRASTÃO"
                theme_text_color: "Primary"
            MDSwitch:
                id: switch_prio
                active: True

        MDFillRoundFlatButton:
            text: "APLICAR NO MOTO G30"
            size_hint_x: 1
            md_bg_color: get_color_from_hex('#39FF14')
            text_color: 0, 0, 0, 1
            on_release: app.apply_hardware_logic()

        MDLabel:
            id: log_label
            text: "> Sistema Aguardando..."
            halign: "center"
            font_style: "Caption"
            theme_text_color: "Hint"
