#:import get_color_from_hex kivy.utils.get_color_from_hex

MDScreen:
    md_bg_color: 0, 0, 0, 1

    Widget:
        canvas:
            Color:
                rgba: get_color_from_hex('#39FF14')
            Line:
                circle: (self.center_x, self.center_y + dp(100), dp(85))
                width: dp(2)
            Color:
                rgba: 0.22, 1, 0.08, 0.1
            Line:
                circle: (self.center_x, self.center_y + dp(100), dp(95))
                width: dp(4)

    MDBoxLayout:
        orientation: 'vertical'
        padding: dp(25)
        spacing: dp(15)

        MDLabel:
            text: "SUPREMEFLY REGEDIT"
            halign: "center"
            font_style: "H4"
            bold: True
            theme_text_color: "Custom"
            text_color: get_color_from_hex('#39FF14')
            size_hint_y: None
            height: dp(80)

        Widget:
            size_hint_y: None
            height: dp(180)

        MDLabel:
            text: "SENSIBILIDADE DE HARDWARE"
            theme_text_color: "Secondary"
            font_style: "Caption"
            halign: "center"

        MDSlider:
            id: sensi_x
            min: 0
            max: 1000
            value: 600
            color: get_color_from_hex('#39FF14')

        MDSlider:
            id: sensi_y
            min: 0
            max: 1000
            value: 750
            color: get_color_from_hex('#39FF14')

        MDFillRoundFlatButton:
            text: "INJETAR VIA SHIZUKU"
            size_hint_x: 1
            md_bg_color: get_color_from_hex('#39FF14')
            text_color: 0, 0, 0, 1
            on_release: app.apply_hardware_logic()

        MDLabel:
            id: log_label
            text: "> SISTEMA PRONTO"
            halign: "center"
            theme_text_color: "Custom"
            text_color: get_color_from_hex('#39FF14')
